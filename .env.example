# Application Port
APP_PORT=8080

# PostgreSQL Database (Chatwoot Compatible)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatwoot_development?sslmode=disable

# Redis (Queues & Dead-letter)
REDIS_URL=redis://localhost:6379/0

# Meta WhatsApp Cloud API Credentials
META_VERIFY_TOKEN=whatsapp_gateway_verify_token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_API_VERSION=v19.0

# Multi-tenancy Defaults
DEFAULT_ACCOUNT_ID=1
DEFAULT_INBOX_ID=1

# Worker Configuration
WORKER_CONCURRENCY=5
LOG_LEVEL=info
